#!/usr/bin/env bash
# Look for secrets in what a push of the data repo's main would send (each commit in origin/main..main, or in
# all of main when there is no origin/main yet). Run it before every push.
#
#   jeeves-scan   exit 0: nothing found; exit 1: each finding listed as file:line and the kind of secret
#
# Also conflict markers, so an unfinished merge never reaches other devices. Only added lines are checked.
# The matched text itself is never printed, so a finding does not spread the secret further. In an encrypted data repo it reads the plain text (with the key), and also refuses any file
# under home/ or hosts/ that main would send unencrypted. The data repo is found as lib/lib.sh describes.

. "$(dirname "$0")/../lib/lib.sh"

[ $# = 0 ] || { echo "scan: takes no options" >&2; exit 2; }
say() { echo "jeeves scan: $*"; }
find_data_repo || { say "$DATA_REPO_PROBLEM"; exit 1; }

# What a push sends: every commit on main that origin/main lacks (all of main before the first push), each
# checked on its own, so a secret added in one commit and removed in a later one is still caught.
if git_repo rev-parse -q --verify refs/remotes/origin/main >/dev/null; then range=origin/main..main; else range=main; fi

found=0
if encrypted_at main; then
  load_key || { say "the data repo's key is not in this device's key store: run /jeeves:unlock"; exit 1; }
  # Each blob under home/ or hosts/ in the outgoing commits, once, with the first commit that holds it.
  while IFS=' ' read -r blob c f; do
    if [ "$(git_repo cat-file blob "$blob" | head -c ${#AGE_MAGIC})" != "$AGE_MAGIC" ]; then
      say "not encrypted: $f (commit $c)"; found=1
    fi
  done < <(git_repo rev-list --abbrev-commit "$range" | while IFS= read -r c; do
      git_repo -c core.quotepath=false ls-tree -r "$c" -- home hosts | awk -F'\t' -v c="$c" '{ split($1, m, " "); print m[3], c, $2 }'
    done | awk '!seen[$1]++')
fi

# Added lines as "<file>\t<line>\t<commit>\t<text>", from each outgoing commit's own diff (a merge's
# combined diff: only lines that match none of its parents, as the rest come from commits checked anyway).
added=$(git_repo -c core.quotepath=false log --no-color --no-ext-diff --format='commit %h' -p --cc -U0 "$range" -- |
  awk '
  /^commit / { c = $2; hunk = 0; next }
  /^diff / { hunk = 0; next }
  !hunk && /^\+\+\+ / { f = substr($0, 7); next }
  /^@@/ { match($0, /^@+/); np = RLENGTH - 1; hunk = 1
          for (i = 2; i <= NF; i++) if (substr($i, 1, 1) == "+") { split(substr($i, 2), a, ","); n = a[1] + 0 }
          next }
  /^\\/ { next }
  hunk { m = substr($0, 1, np)
         if (m ~ /-/) next
         if (m ~ /^\++$/) print f "\t" n "\t" c "\t" substr($0, np + 1)
         n++ }')

look() { # look <kind> <grep flags> <extended regex>
  local hits
  hits=$(printf '%s\n' "$added" | cut -f4- | grep -n $2 -e "$3" | cut -d: -f1)
  for i in $hits; do
    say "possible $1 at $(printf '%s\n' "$added" | sed -n "${i}p" | awk -F'\t' '{ print $1 ":" $2 " (commit " $3 ")" }')"
    found=1
  done
}

if [ -n "$added" ]; then
  look "private key" -E '-----BEGIN ([A-Z]+ )*PRIVATE KEY'
  look "Anthropic API key" -E 'sk-ant-[A-Za-z0-9_-]{20,}'
  look "GitHub token" -E 'gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}'
  look "AWS access key" -E 'A(KIA|SIA)[0-9A-Z]{16}'
  look "Slack token" -E 'xox[abprs]-[A-Za-z0-9-]{10,}'
  # Not a secret, but an unfinished merge would reach every device.
  look "conflict marker (an unfinished merge)" -E '^(<<<<<<<|>>>>>>>)( |$)'
  look "key, token, secret or password value" -Ei \
    '(api[_-]?key|access[_-]?key|token|secret|passw(or)?d)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_./+=-]{16,}'
fi

if [ $found = 1 ]; then
  say "do not push; fix the commits first (rewrite only commits not yet pushed)"
  exit 1
fi
lines=0; [ -n "$added" ] && lines=$(printf '%s\n' "$added" | wc -l | tr -d ' ')
say "nothing found in $lines added lines"
