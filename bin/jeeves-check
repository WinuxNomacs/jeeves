#!/usr/bin/env bash
# jeeves-check: what /jeeves:setup needs to know about this machine.
# lib/launch.sh runs the Go build from dist/ (the code: internal/check/).
# Its folder: from the path it was run by, or for a bare name (`bash jeeves-check`), the file bash ran: here,
# or found on the PATH. Never a folder relative to wherever the caller stands.
case "$0" in
  */*) jeeves_bin=${0%/*} ;;
  *) if [ -f "$0" ]; then jeeves_bin=.
     else jeeves_bin=$(type -P -- "$0"); jeeves_bin=${jeeves_bin%/*}; fi ;;
esac
[ -n "$jeeves_bin" ] || { echo "jeeves-check: cannot find its own folder" >&2; exit 1; }
. "$jeeves_bin/../lib/launch.sh" check "$@"
