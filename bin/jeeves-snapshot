#!/usr/bin/env bash
# Record the on-disk ~/.claude preferences in the data repo and commit them on its main.
#
#   jeeves-snapshot           pull (fast-forward only), copy changed shared files into home/, back up this
#                             device's settings, keybindings and memories to hosts/<host>/, commit
#   jeeves-snapshot --force   also take the disk copy of files changed on both sides (conflicts)
#   jeeves-snapshot --hook    for the hooks: always exits 0, prints only when something needs attention
#   jeeves-snapshot --no-pull skip contacting the remote
#
# The data repo is found as lib/lib.sh describes (JEEVES_DATA, the plugin option, or the current folder).
#
# Never pushes (at session start it runs jeeves-cleanup --auto, which may: see there). The hosts/<host>/
# backup is only ever written by that host and is never applied back (jeeves-restore copies it onto a
# machine on request). A shared file whose name another OS can't hold is not taken.

. "$(dirname "$0")/../lib/lib.sh"

hook=0 force=0 pull=1
for arg in "$@"; do
  case "$arg" in
    --hook) hook=1 ;;
    --force) force=1 ;;
    --no-pull) pull=0 ;;
    *) echo "snapshot: unknown option $arg" >&2; exit 2 ;;
  esac
done

say() { echo "jeeves snapshot: $*"; }
finish() { if [ $hook = 1 ]; then exit 0; else exit "$1"; fi; }

find_data_repo || { say "skipped, $DATA_REPO_PROBLEM"; finish 1; }

# Guard: only commit onto a clean main, never in the middle of other work.
branch=$(git_repo symbolic-ref --short -q HEAD)
if [ "$branch" != main ]; then
  say "skipped, $REPO is on '${branch:-detached HEAD}', not main; ~/.claude changes are not recorded yet"
  finish 1
fi
# Uncommitted changes that an earlier snapshot left (it failed or was stopped between copying and
# committing): home/ files that match ~/.claude, and this device's own backup. Anything else is not ours.
only_own_leftovers() {
  local line p
  while IFS= read -r line; do
    p=${line#???}
    case "$p" in
      hosts/"$HOST"/*|memory/"$HOST"/*) ;;
      home/*)
        p=${p#home/}
        if [ -f "$HOME_COPY/$p" ]; then cmp -s "$HOME_COPY/$p" "$CLAUDE_HOME/$p" || return 1
        else [ ! -e "$CLAUDE_HOME/$p" ] || return 1
        fi ;;
      *) return 1 ;;
    esac
  done < <(git_repo -c core.quotepath=false status --porcelain --untracked-files=all)
}
if [ -f "$REPO/.git/MERGE_HEAD" ] || { [ -n "$(git_repo status --porcelain)" ] && ! only_own_leftovers; }; then
  say "skipped, $REPO has uncommitted changes; ~/.claude changes are not recorded yet"
  finish 1
fi

if encrypted && [ -z "$(age_version)" ]; then
  say "skipped, the data repo is encrypted and age is not installed here (/jeeves:setup offers to install it)"
  finish 1
fi

# Another device cleaned up the history (jeeves-cleanup): origin/main shares no commit with main. Keep this
# device's old history in a bundle and take the new one. Files this device changed in commits it never
# pushed get, as their last synced version, the one it last shared with origin, so the disk loop below
# records them again (or reports a conflict) instead of taking them for older than the repo's.
switch_to_cleaned_history() {
  local p
  mkdir -p "$STATE_DIR"
  git_repo bundle create "$STATE_DIR/$CLEANUP_BUNDLE_NAME" main >/dev/null 2>&1
  if [ -n "$last_origin" ] && git_repo cat-file -e "$last_origin^{commit}" 2>/dev/null; then
    git_repo diff --name-only "$last_origin" HEAD -- home/ | sed 's#^home/##' | while IFS= read -r p; do
      if git_repo cat-file -e "$last_origin:home/$p" 2>/dev/null; then
        git_repo cat-file --filters "$last_origin:home/$p" > "$STATE_DIR/base.sync-tmp" &&
          set_base "$p" "$(hash_of "$STATE_DIR/base.sync-tmp")" "$STATE_DIR/base.sync-tmp"
      else
        set_base "$p" -
      fi
    done
    rm -f "$STATE_DIR/base.sync-tmp"
  else
    # Nothing known as shared: every file that differs from the repo becomes a conflict to merge.
    all_tracked | while IFS= read -r p; do set_base "$p" -; done
  fi
  git_repo reset -q --hard origin/main
  shrink_repo
  say "the history was cleaned up on another device; switched to it (this device's old history is in" \
      ".sync-state/$CLEANUP_BUNDLE_NAME)"
}

# Bring in what other devices pushed. Offline or slow is fine: carry on locally.
last_origin=$(git_repo rev-parse -q --verify refs/remotes/origin/main)
if [ $pull = 1 ] && git_repo remote get-url origin >/dev/null 2>&1; then
  if remote_git fetch -q origin main 2>/dev/null; then
    if [ "$(git_repo rev-parse HEAD)" = "$(git_repo rev-parse origin/main)" ]; then
      :
    elif encrypted_at origin/main && ! unlocked; then
      say "another device encrypted the data repo; this device is locked, so its changes are not taken: run /jeeves:unlock"
    elif encrypted_at origin/main && ! load_key; then
      say "the data repo's key is not in this device's key store, so other devices' changes are not taken: run /jeeves:unlock"
    elif ! git_repo merge-base HEAD origin/main >/dev/null 2>&1 && cleaned_root origin/main; then
      switch_to_cleaned_history
    elif git_repo merge-base --is-ancestor HEAD origin/main; then
      git_repo merge -q --ff-only origin/main >/dev/null
    elif ! git_repo merge-base --is-ancestor origin/main HEAD; then
      say "main and origin/main have diverged; recording locally, merge them before pushing"
    fi
  elif [ $hook = 0 ]; then
    say "could not reach origin, recording locally"
  fi
fi

# A ~/.claude with none of the shared files, on a device that has synced them: most likely the folder moved
# or was emptied, and taking that would delete them on every device. Record nothing and say so.
if [ -z "$(tracked_under "$CLAUDE_HOME")" ] && [ -n "$(tracked_under "$HOME_COPY")" ] &&
   [ -n "$(awk -F'\t' '$2 !~ /^(settings|keybindings)\.json$/' "$STATE_FILE" 2>/dev/null)" ]; then
  say "skipped, $CLAUDE_HOME holds none of the shared files (CLAUDE.md, agents/, commands/, skills/) that" \
      "this device synced before; recording that would delete them on every device. If that is what you" \
      "want, remove them from home/ in the data repo with /jeeves:update"
  finish 1
fi

taken=() pending=() conflicts=() refused=() deleted=()
collisions=$(all_tracked | case_collisions)
while IFS= read -r p; do
  [ -n "$p" ] || continue
  d=$(hash_of "$CLAUDE_HOME/$p"); r=$(hash_of "$HOME_COPY/$p"); b=$(base_of "$p")
  state=$(classify "$d" "$r" "$b")
  [ "$state" = conflict ] && [ $force = 1 ] && state=disk
  case "$state" in
    insync) set_base "$p" "$d" "$CLAUDE_HOME/$p" ;;
    disk)
      why=
      if [ "$d" != "-" ]; then
        why=$(bad_name "$p")
        if [ -z "$why" ] && printf '%s\n' "$collisions" | grep -qxF -- "$p"; then
          why="another file's name differs from it only in case, which collides on Windows and macOS"
        fi
      fi
      if [ -n "$why" ]; then refused+=("$p ($why)"); continue; fi
      if [ "$d" = "-" ]; then rm -f "$HOME_COPY/$p"; deleted+=("$p"); else copy_file "$CLAUDE_HOME/$p" "$HOME_COPY/$p"; fi
      taken+=("$p") ;;
    repo) pending+=("$p") ;;
    conflict) conflicts+=("$p") ;;
  esac
done < <(all_tracked)

# This device's backup: mirror its per-device files and memory folders into hosts/<host>/ (laid out as in
# ~/.claude), so deletions show up in history too.
rm -rf "${HOST_DIR:?}"
for f in $HOST_FILES; do
  [ -f "$CLAUDE_HOME/$f" ] && copy_file "$CLAUDE_HOME/$f" "$HOST_DIR/$f"
done
for dir in "$CLAUDE_HOME"/projects/*/memory; do
  [ -d "$dir" ] || continue
  [ -n "$(ls -A "$dir")" ] || continue
  key=$(basename "$(dirname "$dir")")
  mkdir -p "$HOST_DIR/projects/$key/memory"
  cp -pR "$dir"/. "$HOST_DIR/projects/$key/memory"/
done
# Layout before per-device backups: per-device files were shared in home/, memories in memory/<host>/.
for f in $HOST_FILES; do rm -f "$HOME_COPY/$f"; set_base "$f" -; done
rm -rf "${REPO:?}/memory/${HOST:?}"

# On a failure, nothing is staged; the copies stay, and the next snapshot recognises them as its own.
undo_copies() { git_repo reset -q; }
if ! err=$(git_repo add -A 2>&1); then
  # Encryption failed (the filter is required), or git could not read a file: record nothing, so the next
  # snapshot tries again.
  undo_copies
  say "could not record the changes: $(printf '%s' "$err" | grep -v '^warning' | head -2 | join_lines)"
  finish 1
fi
if ! git_repo diff --cached --quiet; then
  changed=$(git_repo diff --cached --name-only | sed -e 's#^home/##' -e "s#^hosts/$HOST/projects/.*#memories#" \
    -e "s#^memory/$HOST/.*#memories#" -e "s#^hosts/$HOST/#backup #" | sort -u | join_lines)
  git_repo commit -q -m "snapshot($HOST): $changed" \
    -m "Recorded by jeeves-snapshot from $CLAUDE_HOME." || { undo_copies; say "commit failed; nothing recorded"; finish 1; }
  # At session start, a routine commit needs no attention; a deletion does (it reaches every device).
  [ $hook = 1 ] || say "committed $changed"
  [ ${#deleted[@]} -gt 0 ] && say "deleted from the shared files, so from every device at its next sync:" \
    "$(printf '%s\n' "${deleted[@]}" | join_lines)"
fi
for p in ${taken[@]+"${taken[@]}"}; do set_base "$p" "$(hash_of "$CLAUDE_HOME/$p")" "$CLAUDE_HOME/$p"; done
keep_bases

status=0
if [ ${#refused[@]} -gt 0 ]; then
  say "not taken, so every device can hold it: $(printf '%s; ' "${refused[@]}" | sed 's/; $//'); rename it in ~/.claude"
  status=1
fi
if [ ${#pending[@]} -gt 0 ]; then
  say "the repo has newer $(printf '%s\n' "${pending[@]}" | join_lines); run jeeves-apply to install them, or /jeeves:update"
fi
if [ ${#conflicts[@]} -gt 0 ]; then
  say "changed both on disk and in the repo: $(printf '%s\n' "${conflicts[@]}" | join_lines);" \
      "merge them with /jeeves:update, or keep the disk copy with 'jeeves-snapshot --force' or the repo copy with 'jeeves-apply --force'"
  status=1
fi
# At session start, the automatic history cleanup, when jeeves.conf turns it on and one is due.
[ $hook = 1 ] && [ $pull = 1 ] && JEEVES_AGE_KEY= "$(dirname "$0")/jeeves-cleanup" --auto
finish $status
