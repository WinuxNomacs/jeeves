#!/usr/bin/env bash
# Flag lines that a push of the data repo's main would add under home/ (the files every device installs)
# and that could make a session run outside code, gain permissions or hooks, or obey text it reads. Run it
# after jeeves-scan, before every push: a flag is for the user to look at and decide on, not proof of harm.
#
#   jeeves-risk   exit 0: nothing flagged; exit 1: each flag listed as file:line (commit) and its kind
#
# The checks are risk_flags in lib/lib.sh; the commits are those jeeves-scan checks (origin/main..main, or
# all of main before the first push). In an encrypted data repo it reads the plain text (with the key).
# The data repo is found as lib/lib.sh describes.

. "$(dirname "$0")/../lib/lib.sh"

[ $# = 0 ] || { echo "risk: takes no options" >&2; exit 2; }
say() { echo "jeeves risk: $*"; }
find_data_repo || { say "$DATA_REPO_PROBLEM"; exit 1; }

if git_repo rev-parse -q --verify refs/remotes/origin/main >/dev/null; then range=origin/main..main; else range=main; fi
if encrypted_at main; then
  load_key || { say "the data repo's key is not in this device's key store: run /jeeves:unlock"; exit 1; }
fi

lines=$(outgoing_added "$range" | awk -F'\t' '$1 ~ /^home\// {
  t = $0; sub(/^[^\t]*\t[^\t]*\t[^\t]*\t/, "", t); print $1 ":" $2 " (commit " $3 ")\t" t }')
flags=$(printf '%s\n' "$lines" | risk_flags)
if [ -n "$flags" ]; then
  # Each flag, then the line itself (jeeves-scan, run first, has stopped any secret), cut to 200 characters.
  printf '%s\n' "$flags" | while IFS= read -r f; do
    echo "jeeves risk: flagged $f"
    where=${f%%: *}
    printf '%s\n' "$lines" | awk -F'\t' -v w="$where" '$1 == w { t = $0; sub(/^[^\t]*\t/, "", t); print "    " substr(t, 1, 200); exit }'
  done
  say "ask the user about each flagged line before pushing: it reaches every device"
  exit 1
fi
say "nothing flagged"
