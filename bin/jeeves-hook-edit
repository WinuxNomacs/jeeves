#!/usr/bin/env bash
# jeeves-hook-edit: the PostToolUse hook that snapshots right after an edit to ~/.claude/CLAUDE.md.
# lib/launch.sh runs the Go build from dist/ (the code: internal/hookedit/), or the bash version
# (lib/hook-edit.sh) where there is none.
# Its folder: from the path it was run by, or for a bare name (`bash jeeves-hook-edit`), the file bash ran: here,
# or found on the PATH. Never a folder relative to wherever the caller stands.
case "$0" in
  */*) jeeves_bin=${0%/*} ;;
  *) if [ -f "$0" ]; then jeeves_bin=.
     else jeeves_bin=$(type -P -- "$0"); jeeves_bin=${jeeves_bin%/*}; fi ;;
esac
[ -n "$jeeves_bin" ] || { echo "jeeves-hook-edit: cannot find its own folder" >&2; exit 1; }
. "$jeeves_bin/../lib/launch.sh" hook-edit "$@"
