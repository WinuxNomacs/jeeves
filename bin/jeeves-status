#!/usr/bin/env bash
# Report, without changing anything, what is out of sync between ~/.claude and the data repo (lib/status.sh
# describes the output). lib/launch.sh runs the Go build, or the bash version where there is none.
case "$0" in */*) . "${0%/*}/../lib/launch.sh" status "$@" ;; *) . ../lib/launch.sh status "$@" ;; esac
