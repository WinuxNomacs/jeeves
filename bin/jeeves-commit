#!/usr/bin/env bash
# jeeves-commit: the named files under home/ (or jeeves.conf, the data repo's CLAUDE.md) committed in the
# data repo; --fold folds the commits not yet pushed into one.
# lib/launch.sh runs the Go build from dist/ (the code: internal/version/).
# Its folder: from the path it was run by, or for a bare name (`bash jeeves-snapshot`), the file bash ran: here,
# or found on the PATH. Never a folder relative to wherever the caller stands.
case "$0" in
  */*) jeeves_bin=${0%/*} ;;
  *) if [ -f "$0" ]; then jeeves_bin=.
     else jeeves_bin=$(type -P -- "$0"); jeeves_bin=${jeeves_bin%/*}; fi ;;
esac
[ -n "$jeeves_bin" ] || { echo "jeeves-commit: cannot find its own folder" >&2; exit 1; }
. "$jeeves_bin/../lib/launch.sh" commit "$@"
