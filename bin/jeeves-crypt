#!/usr/bin/env bash
# jeeves-crypt: git's filter (a long-running process, or clean and smudge per file), textconv and merge driver
# for an encrypted data repo, set up in its .git/config; not for running by hand.
# lib/launch.sh runs the Go build from dist/ (the code: internal/crypt/). It has no bash version: git's
# filter must never fall back to anything else.
case "$0" in
  */*) jeeves_bin=${0%/*} ;;
  *) if [ -f "$0" ]; then jeeves_bin=.
     else jeeves_bin=$(type -P -- "$0"); jeeves_bin=${jeeves_bin%/*}; fi ;;
esac
[ -n "$jeeves_bin" ] || { echo "jeeves-crypt: cannot find its own folder" >&2; exit 1; }
. "$jeeves_bin/../lib/launch.sh" crypt "$@"
