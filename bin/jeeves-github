#!/usr/bin/env bash
# jeeves-github find | create <name>: the data repo on GitHub, through gh.
# lib/launch.sh runs the Go build from dist/ (the code: internal/github/).
# Its folder: from the path it was run by, or for a bare name (`bash jeeves-github`), the file bash ran: here,
# or found on the PATH. Never a folder relative to wherever the caller stands.
case "$0" in
  */*) jeeves_bin=${0%/*} ;;
  *) if [ -f "$0" ]; then jeeves_bin=.
     else jeeves_bin=$(type -P -- "$0"); jeeves_bin=${jeeves_bin%/*}; fi ;;
esac
[ -n "$jeeves_bin" ] || { echo "jeeves-github: cannot find its own folder" >&2; exit 1; }
. "$jeeves_bin/../lib/launch.sh" github "$@"
