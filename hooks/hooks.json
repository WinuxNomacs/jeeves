{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/jeeves-snapshot --hook" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/jeeves-auto --session-start" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/jeeves-hook-edit" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/jeeves-auto --hook-stop" }
        ]
      }
    ]
  }
}
